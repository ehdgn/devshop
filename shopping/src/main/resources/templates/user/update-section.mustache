<form action="/user/update" method="post" class="mp-panel mp-form">
    <label class="mp-field">
        <span>비밀번호 <em class="req-star">*</em></span>
        {{! 저장된 비밀번호(암호화된 값)를 화면에 넣으면 그대로 다시 암호화돼 로그인이 안 된다. 매번 직접 입력받는다. }}
        <input type="password" name="password" required minlength="6" maxlength="16" autocomplete="new-password"
               placeholder="지금 비밀번호 또는 새 비밀번호 (6~16자)">
    </label>

    <label class="mp-field">
        <span>닉네임 <em class="req-star">*</em></span>
        <input type="text" name="nickname" value="{{sessionUser.nickname}}" required minlength="2" maxlength="6">
    </label>

    <div class="mp-field">
        <span>주소 <em class="req-star">*</em></span>
        {{> user/address-form }}
    </div>

    <fieldset class="mp-field">
        <legend>성별</legend>
        <div class="gender-group">
            <label class="gender-card"><input type="radio" name="gender" value="M" {{#isMale}}checked{{/isMale}}><span class="gender-text">남성</span></label>
            <label class="gender-card"><input type="radio" name="gender" value="F" {{#isFeMale}}checked{{/isFeMale}}><span class="gender-text">여성</span></label>
            <label class="gender-card"><input type="radio" name="gender" value="N" {{#isNone}}checked{{/isNone}}><span class="gender-text">선택 안 함</span></label>
        </div>
    </fieldset>

    <div class="mp-form-actions">
        <button type="submit" class="btn-buy">저장</button>
    </div>
</form>
