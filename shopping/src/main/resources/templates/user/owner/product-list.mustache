{{> layout/header}}

<main class="site-container mp sc">
    {{> layout/owner-nav}}

    <section class="mp-body">
        <div class="sc-titlebar">
            <h1 class="mp-title">상품 관리</h1>
            <a href="/owner/products/save" class="btn-buy sc-add"><i class="bi bi-plus-lg" aria-hidden="true"></i>상품 등록</a>
        </div>

        <form action="/owner/products/search" method="get" class="mp-search" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="keyword" value="{{#keyword}}{{keyword}}{{/keyword}}" placeholder="상품 이름으로 찾기" aria-label="상품 검색" required>
            {{#keyword}}<a href="/owner/products" class="mp-search-reset">전체 보기</a>{{/keyword}}
        </form>

        {{#hasProducts}}
        <div class="sc-table-wrap">
            <table class="sc-table">
                <thead>
                <tr>
                    <th scope="col">상품</th>
                    <th scope="col" class="sc-opt">카테고리</th>
                    <th scope="col" class="num">가격</th>
                    <th scope="col" class="num">재고</th>
                    <th scope="col" class="num sc-opt">판매</th>
                    <th scope="col">상태</th>
                    <th scope="col"><span class="visually-hidden">관리</span></th>
                </tr>
                </thead>
                <tbody>
                {{#products}}
                <tr>
                    <td>
                        <a href="/owner/products/{{id}}" class="sc-product">
                            <img src="{{thumbnailUrl}}" alt="">
                            <span>{{productName}}</span>
                        </a>
                    </td>
                    <td class="sc-muted sc-opt">{{categoryName}}</td>
                    <td class="num">{{priceText}}원</td>
                    <td class="num">{{stockQuantity}}</td>
                    <td class="num sc-opt">{{minusQuantity}}</td>
                    <td><span class="sc-badge" data-status="{{status}}">{{statusLabel}}</span></td>
                    <td class="sc-row-actions"><a href="/owner/products/{{id}}/edit" class="btn-line">수정</a></td>
                </tr>
                {{/products}}
                </tbody>
            </table>
        </div>
        {{/hasProducts}}

        {{^products}}
        <div class="pd-empty">
            <i class="bi bi-box-seam" aria-hidden="true"></i>
            <p>{{#keyword}}'{{keyword}}'에 맞는 상품이 없어요.{{/keyword}}{{^keyword}}아직 등록한 상품이 없어요.{{/keyword}}</p>
            <a href="/owner/products/save" class="btn-line ct-empty-link">첫 상품 등록하기</a>
        </div>
        {{/products}}
    </section>
</main>

{{> layout/footer}}
