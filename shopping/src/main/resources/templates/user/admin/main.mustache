{{> layout/header}}

<main class="site-container mp sc">
    {{> layout/admin-nav}}

    <section class="mp-body">
        <h1 class="mp-title">운영 현황</h1>

        <div class="sc-stats ad-stats">
            <a href="/admin/list" class="sc-stat"><span>전체 회원</span><strong>{{userCount}}</strong></a>
            <a href="/admin/owner/list" class="sc-stat sc-stat-warn"><span>승인 대기 입점사</span><strong>{{waitOwnerCount}}</strong></a>
            <a href="/admin/products" class="sc-stat"><span>전체 상품</span><strong>{{productCount}}</strong></a>
            <a href="/admin/chat/list" class="sc-stat"><span>상담 방</span><strong>{{chatCount}}</strong></a>
        </div>

        <div class="sc-grid">
            <section class="mp-panel">
                <header class="sc-panel-head">
                    <h2>승인 대기 입점사</h2>
                    <a href="/admin/owner/list">전체 보기 <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                </header>
                {{#waitOwners}}
                <div class="sc-mini">
                    <span class="sc-mini-name">{{ownerName}}<small>상품 {{totalProduct}}개</small></span>
                    <form action="/admin/owner/{{id}}/approve" method="post">
                        <button type="submit" class="btn-buy ad-small">승인</button>
                    </form>
                </div>
                {{/waitOwners}}
                {{^waitOwners}}
                <p class="sc-none">기다리는 입점 신청이 없어요.</p>
                {{/waitOwners}}
            </section>

            <section class="mp-panel">
                <header class="sc-panel-head">
                    <h2>최근 가입 회원</h2>
                    <a href="/admin/list">전체 보기 <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                </header>
                {{#recentUsers}}
                <div class="sc-mini">
                    <span class="sc-mini-name">{{nickname}}<small>{{username}} · {{createdAtText}}</small></span>
                    <span class="sc-badge ad-role" data-role="{{role}}">{{roleLabel}}</span>
                </div>
                {{/recentUsers}}
                {{^recentUsers}}
                <p class="sc-none">아직 가입한 회원이 없어요.</p>
                {{/recentUsers}}
            </section>
        </div>
    </section>
</main>

{{> layout/footer}}
