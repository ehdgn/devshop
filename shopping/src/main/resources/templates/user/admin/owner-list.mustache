{{> layout/header}}

<main class="site-container mp sc">
    {{> layout/admin-nav}}

    <section class="mp-body">
        <h1 class="mp-title">입점사</h1>

        <div class="sc-table-wrap">
            <table class="sc-table">
                <thead>
                <tr>
                    <th scope="col">입점사</th>
                    <th scope="col" class="num">보유 상품</th>
                    <th scope="col">상태</th>
                    <th scope="col"><span class="visually-hidden">관리</span></th>
                </tr>
                </thead>
                <tbody>
                {{#ownerList}}
                <tr>
                    <td><strong>{{ownerName}}</strong></td>
                    <td class="num">{{totalProduct}}개</td>
                    <td><span class="sc-badge ad-owner" data-status="{{ownerStatus}}">{{statusLabel}}</span></td>
                    <td class="sc-row-actions">
                        {{#isAPPROVED}}
                        <form action="/admin/owner/{{id}}/suspension" method="post" onsubmit="return confirm('이 입점사를 정지할까요?');">
                            <button type="submit" class="btn-line sc-delete ad-small">정지</button>
                        </form>
                        {{/isAPPROVED}}
                        {{^isAPPROVED}}
                        <form action="/admin/owner/{{id}}/approve" method="post">
                            <button type="submit" class="btn-buy ad-small">{{#isWAIT}}승인{{/isWAIT}}{{^isWAIT}}정지 풀기{{/isWAIT}}</button>
                        </form>
                        {{/isAPPROVED}}
                    </td>
                </tr>
                {{/ownerList}}
                {{^ownerList}}
                <tr><td colspan="4" class="sc-none">입점사가 없어요.</td></tr>
                {{/ownerList}}
                </tbody>
            </table>
        </div>
    </section>
</main>

{{> layout/footer}}
