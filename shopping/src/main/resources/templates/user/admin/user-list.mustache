{{> layout/header}}

<main class="site-container mp sc">
    {{> layout/admin-nav}}

    <section class="mp-body">
        <h1 class="mp-title">회원</h1>

        <div class="sc-table-wrap">
            <table class="sc-table">
                <thead>
                <tr>
                    <th scope="col">닉네임</th>
                    <th scope="col">아이디</th>
                    <th scope="col">이메일</th>
                    <th scope="col">권한</th>
                    <th scope="col">가입일</th>
                    <th scope="col"><span class="visually-hidden">관리</span></th>
                </tr>
                </thead>
                <tbody>
                {{#userList}}
                <tr>
                    <td><strong>{{nickname}}</strong></td>
                    <td class="sc-muted">{{username}}</td>
                    <td class="sc-muted">{{#email}}{{email}}{{/email}}</td>
                    <td><span class="sc-badge ad-role" data-role="{{role}}">{{roleLabel}}</span></td>
                    <td class="sc-muted">{{createdAtText}}</td>
                    <td class="sc-row-actions">
                        {{^admin}}
                        <form action="/admin/user/{{id}}/delete" method="post" onsubmit="return confirm('이 회원을 삭제할까요? 되돌릴 수 없어요.');">
                            <button type="submit" class="btn-line sc-delete ad-small">삭제</button>
                        </form>
                        {{/admin}}
                    </td>
                </tr>
                {{/userList}}
                {{^userList}}
                <tr><td colspan="6" class="sc-none">회원이 없어요.</td></tr>
                {{/userList}}
                </tbody>
            </table>
        </div>
    </section>
</main>

{{> layout/footer}}
