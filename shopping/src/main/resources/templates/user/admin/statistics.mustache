{{> layout/header}}

<main class="site-container mp sc">
    {{> layout/admin-nav}}

    <section class="mp-body">
        <h1 class="mp-title">결제 내역</h1>

        <div class="sc-grid ad-charts">
            <section class="mp-panel">
                <header class="sc-panel-head"><h2>결제 상태</h2></header>
                <div class="ad-chart"><canvas id="statusChart" role="img" aria-label="결제 상태별 건수 도넛 그래프"></canvas></div>
            </section>
            <section class="mp-panel">
                <header class="sc-panel-head"><h2>결제 수단</h2></header>
                <div class="ad-chart"><canvas id="methodChart" role="img" aria-label="결제 수단별 건수 도넛 그래프"></canvas></div>
            </section>
        </div>

        <div class="sc-table-wrap">
            <table class="sc-table">
                <thead>
                <tr>
                    <th scope="col">일시</th>
                    <th scope="col">회원</th>
                    <th scope="col">상품</th>
                    <th scope="col" class="num">금액</th>
                    <th scope="col">수단</th>
                    <th scope="col">상태</th>
                </tr>
                </thead>
                <tbody>
                {{#historyList}}
                <tr>
                    <td class="sc-muted">{{createdAtText}}</td>
                    <td>{{username}}</td>
                    <td>{{productName}}</td>
                    <td class="num">{{amountText}}원</td>
                    <td class="sc-muted">{{method}}</td>
                    <td><span class="sc-badge ad-pay" data-status="{{newValue}}">{{statusLabel}}</span></td>
                </tr>
                {{/historyList}}
                {{^historyList}}
                <tr><td colspan="6" class="sc-none">아직 결제 내역이 없어요.</td></tr>
                {{/historyList}}
                </tbody>
            </table>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    const rows = [];
    {{#historyList}}
    rows.push({status: "{{statusLabel}}", method: "{{method}}"});
    {{/historyList}}

    const countBy = key => rows.reduce((acc, r) => (acc[r[key]] = (acc[r[key]] || 0) + 1, acc), {});
    const palette = ['#f3b660', '#6fd3a5', '#ff7a7a', '#a0a2a9', '#ecebe7', '#5b5e66'];

    Chart.defaults.color = '#a0a2a9';
    Chart.defaults.borderColor = '#2e3035';
    function doughnut(id, counts) {
        new Chart(document.getElementById(id), {
            type: 'doughnut',
            data: {labels: Object.keys(counts), datasets: [{data: Object.values(counts), backgroundColor: palette, borderColor: '#1f2024', borderWidth: 2}]},
            options: {responsive: true, maintainAspectRatio: false, plugins: {legend: {position: 'bottom'}}}
        });
    }
    doughnut('statusChart', countBy('status'));
    doughnut('methodChart', countBy('method'));
</script>

{{> layout/footer}}
