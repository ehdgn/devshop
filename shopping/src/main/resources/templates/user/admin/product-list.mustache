{{> layout/header }}

<main class="site-container mp sc">
    {{> layout/admin-nav}}

    <section class="mp-body">
        <h1 class="mp-title">상품</h1>

        <form action="/admin/products/search" method="get" class="mp-search" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="keyword" value="{{#keyword}}{{keyword}}{{/keyword}}" placeholder="상품 이름으로 찾기" aria-label="상품 검색" required>
            {{#keyword}}<a href="/admin/products" class="mp-search-reset">전체 보기</a>{{/keyword}}
        </form>

        {{#hasProducts}}
        <div class="sc-table-wrap">
            <table class="sc-table">
                <thead>
                <tr>
                    <th scope="col">상품</th>
                    <th scope="col">판매자</th>
                    <th scope="col">카테고리</th>
                    <th scope="col" class="num">가격</th>
                    <th scope="col" class="num">재고</th>
                    <th scope="col">상태</th>
                </tr>
                </thead>
                <tbody>
                {{#products}}
                <tr>
                    <td>
                        <a href="/admin/products/{{id}}" class="sc-product">
                            <img src="{{thumbnailUrl}}" alt="">
                            <span>{{productName}}</span>
                        </a>
                    </td>
                    <td class="sc-muted">{{ownerName}}</td>
                    <td class="sc-muted">{{categoryName}}</td>
                    <td class="num">{{priceText}}원</td>
                    <td class="num">{{stockQuantity}}</td>
                    <td><span class="sc-badge" data-status="{{status}}">{{statusLabel}}</span></td>
                </tr>
                {{/products}}
                </tbody>
            </table>
        </div>
        {{/hasProducts}}

        {{^products}}
        <div class="pd-empty">
            <i class="bi bi-box-seam" aria-hidden="true"></i>
            <p>{{#keyword}}'{{keyword}}'에 맞는 상품이 없어요.{{/keyword}}{{^keyword}}등록된 상품이 없어요.{{/keyword}}</p>
        </div>
        {{/products}}
    </section>
</main>

{{> layout/footer }}
