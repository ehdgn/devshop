{{> layout/header}}

<main class="site-container mp sc">
    {{> layout/admin-nav}}

    <section class="mp-body">
        <a href="/admin/categories/list" class="mp-more mp-back"><i class="bi bi-chevron-left" aria-hidden="true"></i> 카테고리 목록</a>
        <h1 class="mp-title">카테고리 수정</h1>

        <form action="/admin/categories/{{category.id}}/edit" method="post" class="mp-panel mp-form sc-form ad-narrow">
            <p class="ad-kind">
                {{#category.parentName}}소분류 · 상위 카테고리 {{category.parentName}}{{/category.parentName}}
                {{^category.parentName}}대분류{{/category.parentName}}
            </p>
            <label class="mp-field">
                <span>이름 <em class="req-star">*</em></span>
                <input type="text" name="categoryName" value="{{category.categoryName}}" required>
            </label>
            <label class="mp-field">
                <span>노출 순서 <em class="req-star">*</em> <small>작을수록 앞에 보여요</small></span>
                <input type="number" name="displayOrder" value="{{#category.displayOrder}}{{category.displayOrder}}{{/category.displayOrder}}" min="0" required>
            </label>
            <div class="mp-form-actions">
                <a href="/admin/categories/list" class="btn-line">취소</a>
                <button type="submit" class="btn-buy">수정 완료</button>
            </div>
        </form>
    </section>
</main>

{{> layout/footer }}
