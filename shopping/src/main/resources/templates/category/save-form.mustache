{{> layout/header }}

<main class="site-container mp sc">
    {{> layout/admin-nav}}

    <section class="mp-body">
        <a href="/admin/categories/list" class="mp-more mp-back"><i class="bi bi-chevron-left" aria-hidden="true"></i> 카테고리 목록</a>
        <h1 class="mp-title">카테고리 등록</h1>

        <div class="sc-grid">
            <form action="/admin/categories/parent-save" method="post" enctype="multipart/form-data" class="mp-panel mp-form sc-form">
                <header class="sc-panel-head"><h2>대분류</h2></header>
                <label class="mp-field">
                    <span>이름 <em class="req-star">*</em></span>
                    <input type="text" name="categoryName" placeholder="예) 키보드·마우스" required>
                </label>
                <label class="mp-field">
                    <span>노출 순서 <small>작을수록 앞에 보여요</small></span>
                    <input type="number" name="displayOrder" value="1" min="1">
                </label>
                <label class="mp-field">
                    <span>대표 이미지 <em class="req-star">*</em></span>
                    <input type="file" name="imageUrl" accept="image/*" required>
                </label>
                <div class="mp-form-actions"><button type="submit" class="btn-buy">대분류 추가</button></div>
            </form>

            <form action="/admin/categories/child-save" method="post" enctype="multipart/form-data" class="mp-panel mp-form sc-form">
                <header class="sc-panel-head"><h2>소분류</h2></header>
                <label class="mp-field">
                    <span>상위 카테고리 <em class="req-star">*</em></span>
                    <select name="parentId" required>
                        <option value="">대분류 선택</option>
                        {{#categories}}<option value="{{id}}">{{categoryName}}</option>{{/categories}}
                    </select>
                </label>
                <label class="mp-field">
                    <span>이름 <em class="req-star">*</em></span>
                    <input type="text" name="categoryName" placeholder="예) 기계식 키보드" required>
                </label>
                <label class="mp-field">
                    <span>노출 순서 <small>작을수록 앞에 보여요</small></span>
                    <input type="number" name="displayOrder" value="1" min="1">
                </label>
                <label class="mp-field">
                    <span>대표 이미지 <em class="req-star">*</em></span>
                    <input type="file" name="imageUrl" accept="image/*" required>
                </label>
                <div class="mp-form-actions"><button type="submit" class="btn-buy">소분류 추가</button></div>
            </form>
        </div>
    </section>
</main>

{{> layout/footer }}
