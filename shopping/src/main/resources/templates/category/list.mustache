{{> layout/header }}

<main class="site-container mp sc">
    {{> layout/admin-nav}}

    <section class="mp-body">
        <div class="sc-titlebar">
            <h1 class="mp-title">카테고리</h1>
            <a href="/admin/categories/save" class="btn-buy sc-add"><i class="bi bi-plus-lg" aria-hidden="true"></i>카테고리 등록</a>
        </div>

        <div class="sc-table-wrap">
            <table class="sc-table">
                <thead>
                <tr>
                    <th scope="col">카테고리</th>
                    <th scope="col">분류</th>
                    <th scope="col">상위 카테고리</th>
                    <th scope="col" class="num">노출 순서</th>
                    <th scope="col"><span class="visually-hidden">관리</span></th>
                </tr>
                </thead>
                <tbody>
                {{#categoryList}}
                <tr>
                    <td>
                        <span class="sc-product"><img src="{{imageUrl}}" alt=""><span>{{categoryName}}</span></span>
                    </td>
                    <td><span class="sc-badge" data-status="{{#parentName}}INACTIVE{{/parentName}}{{^parentName}}ACTIVE{{/parentName}}">{{#parentName}}소분류{{/parentName}}{{^parentName}}대분류{{/parentName}}</span></td>
                    <td class="sc-muted">{{#parentName}}{{parentName}}{{/parentName}}{{^parentName}}-{{/parentName}}</td>
                    <td class="num">{{displayOrder}}</td>
                    <td class="sc-row-actions">
                        <div class="ad-actions">
                            <a href="/admin/categories/{{id}}/edit" class="btn-line">수정</a>
                            <form action="/admin/categories/{{id}}/delete" method="post" onsubmit="return confirm('이 카테고리를 삭제할까요? 되돌릴 수 없어요.')">
                                <button type="submit" class="btn-line sc-delete ad-small">삭제</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {{/categoryList}}
                {{^categoryList}}
                <tr><td colspan="5" class="sc-none">등록된 카테고리가 없어요.</td></tr>
                {{/categoryList}}
                </tbody>
            </table>
        </div>
    </section>
</main>

{{> layout/footer }}
