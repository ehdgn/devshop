{{> layout/header }}

<main class="site-container">
    <section class="shelf">
        <div class="shelf-head">
            <h2>{{category.categoryName}}</h2>
            <p><a href="/" class="text-link">전체 상품 보기</a></p>
        </div>
        <div class="tile-grid">
            {{#products}}
                {{> product/product-tile }}
            {{/products}}
        </div>
        {{^products}}
            <div class="empty-state">
                <p>이 카테고리에는 아직 상품이 없어요.</p>
                <a href="/" class="btn-line">다른 상품 둘러보기</a>
            </div>
        {{/products}}
    </section>
{{> layout/footer }}
