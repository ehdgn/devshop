{{> layout/header }}

<main class="site-container ct">
    <header class="ct-head">
        <h1>주문·결제</h1>
        <ol class="ct-steps" aria-label="주문 단계">
            <li>장바구니</li>
            <li class="on">주문·결제</li>
            <li>완료</li>
        </ol>
    </header>

    {{#cartPayment}}
    <div class="ct-layout">
        <section class="ct-list" aria-label="주문 상품">
            <h2 class="ct-section-title">주문 상품 <b>{{items.size}}</b></h2>
            {{#items}}
            <article class="pay-item">
                <div>
                    <a href="/products/{{productId}}" class="ct-name">{{productName}}</a>
                    <p class="ct-code">{{productCode}} · <span data-won>{{amount}}</span>원 × {{quantity}}개</p>
                </div>
                <p class="ct-price"><strong><span data-won>{{totalPrice}}</span>원</strong></p>
            </article>
            {{/items}}
        </section>

        <aside class="ct-summary" aria-label="결제 금액">
            <h2>결제 금액</h2>
            <dl>
                <div><dt>상품 금액</dt><dd><span data-won>{{totalAmount}}</span>원</dd></div>
                <div><dt>배송비</dt><dd>무료</dd></div>
            </dl>
            <p class="ct-total"><span>최종 결제 금액</span><strong><span data-won>{{totalAmount}}</span>원</strong></p>

            <form action="/payment/cart/{{cartId}}" method="post" class="pay-buttons">
                <button type="button" id="tossPayButton" class="btn-buy ct-order">토스페이로 결제</button>
                <button type="submit" name="method" value="MOCK" class="btn-line ct-order-sub">모의 결제 (테스트용)</button>
            </form>
            <a href="/cart/list" class="ct-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> 장바구니로 돌아가기</a>
        </aside>
    </div>
    {{/cartPayment}}
</main>

<script src="https://js.tosspayments.com/v1"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const button = document.getElementById("tossPayButton");
        if (!button) return;
        const tossPayments = new TossPayments("{{tossClientKey}}");

        button.addEventListener("click", function () {
            const baseUrl = "{{baseUrl}}";
            const cartId = "{{cartPayment.cartId}}";
            try {
                tossPayments.requestPayment("카드", {
                    amount: parseInt("{{cartPayment.totalAmount}}", 10),
                    orderId: "ORD-" + new Date().getTime(),
                    orderName: "장바구니 상품 결제",
                    successUrl: `${baseUrl}/payment/cart/${cartId}/approve?method=TOSS_PAY`,
                    failUrl: `${baseUrl}/payment/cart/${cartId}/fail?method=TOSS_PAY`
                });
            } catch (error) {
                console.error("결제 실패", error);
            }
        });
    });
</script>
{{> layout/footer }}
