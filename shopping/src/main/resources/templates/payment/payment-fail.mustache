{{> layout/header }}

<main class="site-container ct">
    <section class="pay-result">
        <i class="bi bi-x-circle-fill pay-result-icon fail" aria-hidden="true"></i>
        <h1>결제하지 못했어요</h1>
        <p class="pay-result-sub">{{#message}}{{message}}{{/message}}{{^message}}알 수 없는 오류가 발생했어요.{{/message}}</p>
        {{#code}}<p class="pay-result-code">오류 코드 {{code}}</p>{{/code}}

        <ul class="pay-result-help">
            <li>카드 정보와 한도를 확인해 주세요.</li>
            <li>잠시 뒤 다시 시도해 주세요.</li>
        </ul>

        <div class="pay-result-actions">
            {{#cartId}}<a href="/payment?cartId={{cartId}}" class="btn-buy">다시 결제하기</a>{{/cartId}}
            <a href="/cart/list" class="btn-line">장바구니로 가기</a>
        </div>
    </section>
</main>
{{> layout/footer }}
