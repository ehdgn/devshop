{{> layout/header }}

<main class="site-container ct">
    <ol class="ct-steps ct-steps-center" aria-label="주문 단계">
        <li>장바구니</li>
        <li>주문·결제</li>
        <li class="on">완료</li>
    </ol>

    <section class="pay-result">
        <i class="bi bi-check-circle-fill pay-result-icon ok" aria-hidden="true"></i>
        <h1>결제가 완료됐어요</h1>
        <p class="pay-result-sub">판매자가 상품을 준비하면 주문 내역에서 상태를 볼 수 있어요.</p>

        <dl class="pay-result-info">
            <div><dt>주문번호</dt><dd>{{orderId}}</dd></div>
            <div><dt>결제 금액</dt><dd><strong><span data-won>{{amount}}</span>원</strong></dd></div>
            <div><dt>결제 수단</dt><dd>{{method}}</dd></div>
        </dl>

        <ul class="pay-result-items">
            {{#items}}
            <li><span>{{productName}}</span><b><span data-won>{{totalPrice}}</span>원</b></li>
            {{/items}}
        </ul>

        <div class="pay-result-actions">
            <a href="/order/list" class="btn-buy">주문 내역 보기</a>
            <a href="/" class="btn-line">쇼핑 계속하기</a>
        </div>
    </section>
</main>
{{> layout/footer }}
