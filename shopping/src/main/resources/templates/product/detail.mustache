{{> layout/header}}

<main class="site-container mp sc">
    {{> layout/owner-nav}}

    <section class="mp-body">
        {{#product}}
        <a href="/owner/products" class="mp-more mp-back"><i class="bi bi-chevron-left" aria-hidden="true"></i> 상품 목록</a>

        <div class="sc-detail">
            <div class="pd-media sc-detail-media">
                <img src="{{thumbnailUrl}}" alt="{{productName}}">
            </div>

            <div class="sc-detail-info">
                <span class="sc-badge" data-status="{{status}}">{{statusLabel}}</span>
                <h1 class="pd-name">{{productName}}</h1>
                <p class="pd-price"><strong>{{priceText}}</strong>원</p>

                <dl class="pd-facts">
                    <div><dt>상품 코드</dt><dd>{{productCode}}</dd></div>
                    <div><dt>카테고리</dt><dd>{{#categoryName}}{{categoryName}}{{/categoryName}}{{^categoryName}}없음{{/categoryName}}</dd></div>
                    <div><dt>재고</dt><dd>{{stockQuantity}}개</dd></div>
                    <div><dt>판매 수량</dt><dd>{{minusQuantity}}개</dd></div>
                    {{#createdAt}}<div><dt>등록일</dt><dd>{{createdAt}}</dd></div>{{/createdAt}}
                </dl>

                <div class="sc-detail-actions">
                    <a href="/products/{{id}}" class="btn-line" target="_blank" rel="noopener">고객 화면 보기 <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                    <a href="/owner/products/{{id}}/edit" class="btn-buy">정보 수정하기</a>
                </div>
            </div>
        </div>

        <section class="mp-panel sc-desc">
            <h2 class="pd-section-title">상세 설명</h2>
            <div class="product-description">{{{description}}}</div>
        </section>
        {{/product}}
    </section>
</main>

{{> layout/footer }}
