{{> layout/header }}

<main class="site-container mp sc">
    {{> layout/owner-nav}}

    <section class="mp-body">
        <a href="/owner/products/{{product.id}}" class="mp-more mp-back"><i class="bi bi-chevron-left" aria-hidden="true"></i> 상품으로 돌아가기</a>
        <h1 class="mp-title">상품 수정</h1>

        <form action="/owner/products/{{product.id}}/edit" method="post" enctype="multipart/form-data" id="editForm" class="mp-form sc-form">
            {{#product.thumbnailUrl}}<input type="hidden" name="existingThumbnail" value="{{product.thumbnailUrl}}">{{/product.thumbnailUrl}}

            <div class="mp-panel sc-fields">
                <label class="mp-field sc-wide">
                    <span>상품 이름 <em class="req-star">*</em></span>
                    <input type="text" name="productName" value="{{product.productName}}" required>
                </label>
                <label class="mp-field">
                    <span>카테고리 <em class="req-star">*</em></span>
                    <select name="categoryId" id="categorySelect" data-value="{{#product.categoryId}}{{product.categoryId}}{{/product.categoryId}}" required>
                        {{#category}}<option value="{{id}}">{{categoryName}}</option>{{/category}}
                    </select>
                </label>
                <label class="mp-field">
                    <span>판매 상태 <em class="req-star">*</em></span>
                    <select name="status" required>
                        <option value="ACTIVE" {{#product.active}}selected{{/product.active}}>판매중</option>
                        <option value="SOLD_OUT" {{#product.soldOut}}selected{{/product.soldOut}}>품절</option>
                    </select>
                </label>
                <label class="mp-field">
                    <span>가격 (원) <em class="req-star">*</em></span>
                    <input type="number" name="price" min="1" value="{{product.price}}" required>
                </label>
                <label class="mp-field">
                    <span>재고 수량 <em class="req-star">*</em> <small>0이면 품절로 바뀌어요</small></span>
                    <input type="number" name="stockQuantity" min="0" value="{{product.stockQuantity}}" required>
                </label>
                <div class="mp-field sc-wide">
                    <span>대표 이미지 <small>새로 고르면 바뀌어요</small></span>
                    <div class="sc-thumb-row">
                        {{#product.thumbnailUrl}}<img id="previewImage" class="sc-thumb" src="{{product.thumbnailUrl}}" alt="현재 대표 이미지"
                             onerror="this.onerror=null; this.src='/images/{{product.thumbnailUrl}}';">{{/product.thumbnailUrl}}
                        {{^product.thumbnailUrl}}<img id="previewImage" class="sc-thumb" src="/img/no-image.png" alt="">{{/product.thumbnailUrl}}
                        <input type="file" name="thumbnail" id="thumbnailInput" accept="image/*" aria-label="새 대표 이미지 파일">
                    </div>
                </div>
            </div>

            <div class="mp-panel">
                <div class="mp-field">
                    <span>상품 설명</span>
                    <div id="editor"></div>
                    <input type="hidden" name="description" id="description">
                </div>
            </div>

            <div class="mp-form-actions">
                <a href="/owner/products/{{product.id}}" class="btn-line">취소</a>
                <button type="submit" class="btn-buy">수정 완료</button>
            </div>
        </form>

        <div class="mp-panel sc-danger">
            <div>
                <strong>상품 삭제</strong>
                <p>삭제하면 되돌릴 수 없어요.</p>
            </div>
            <form action="/owner/products/{{product.id}}/delete" method="post" onsubmit="return confirm('이 상품을 삭제할까요? 되돌릴 수 없어요.');">
                <button type="submit" class="btn-line sc-delete">상품 삭제</button>
            </form>
        </div>
    </section>
</main>

<textarea id="initialDescription" hidden>{{product.description}}</textarea>
{{> product/editor-script}}
<script>
    // 원래 고른 카테고리를 미리 선택해 둔다
    const categorySelect = document.getElementById('categorySelect');
    categorySelect.value = categorySelect.dataset.value;

    // 설명을 JS 문자열에 직접 넣으면 백틱이나 ${ } 로 스크립트가 끼어들 수 있어 숨긴 textarea 에서 읽는다
    const editor = createEditor(document.getElementById('initialDescription').value);
    document.getElementById('editForm').addEventListener('submit', () => {
        document.getElementById('description').value = editor.getHTML();
    });
</script>

{{> layout/footer }}
