<a href="/products/{{id}}" class="product-tile">
    <div class="tile-image">
        {{#thumbnailUrl}}<img src="{{thumbnailUrl}}" alt="{{name}}" loading="lazy">{{/thumbnailUrl}}
        {{^thumbnailUrl}}<img src="/img/no-image.png" alt="이미지 없음">{{/thumbnailUrl}}
    </div>
    <div class="tile-info">
        <p class="tile-seller"><i class="bi bi-shop" aria-hidden="true"></i> {{ownerName}}</p>
        <p class="tile-name">{{name}}</p>
        <p class="tile-price"><strong>{{price}}원</strong></p>
    </div>
</a>
