{{> layout/header }}

<main class="site-container mp sc">
    {{> layout/admin-nav}}

    <section class="mp-body">
        <h1 class="mp-title">1:1 상담</h1>

        <div class="ad-rooms">
            {{#chatRoomList}}
            <a href="/admin/chat/{{chatRoomId}}" class="sc-stat ad-room">
                <span><i class="bi bi-chat-dots" aria-hidden="true"></i> 상담 방 {{chatRoomId}}</span>
                <strong>{{userId}}번 회원</strong>
                <em>대화 열기 <i class="bi bi-chevron-right" aria-hidden="true"></i></em>
            </a>
            {{/chatRoomList}}
        </div>
        {{^chatRoomList}}
        <div class="pd-empty">
            <i class="bi bi-chat-dots" aria-hidden="true"></i>
            <p>열린 상담이 없어요.</p>
        </div>
        {{/chatRoomList}}
    </section>
</main>

{{> layout/footer}}
