<html lang="ko">
<head>
    <title>DEVSHOP | 개발자 필수템</title>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sockjs-client/1.6.1/sockjs.min.js" integrity="sha512-1QvjE7BtotQjkq8PxLeF6P46gEpBRXuskzIVgjFpekzFVF4yjRgrQvTG1MTOJ3yQgvTteKAcO7DSZI92+u/yZw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/stomp.js/2.3.3/stomp.min.js" integrity="sha512-iKDtgDyTHjAitUDdLljGhenhPwrbBfqTKWO1mkhSFH3A7blITC9MhYon6SjnMhp4o0rADGw9yAC6EW4t5a4K3g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="icon" href="/favicon.ico">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/user/login-form.css">
    <link rel="stylesheet" href="/css/user/join-form.css">
    <link rel="stylesheet" href="/css/user/update-section.css">
    <link rel="stylesheet" href="/css/payment/payment-success.css">
    <link rel="stylesheet" href="/css/payment/payment-fail.css">
    <link rel="stylesheet" href="/css/cart/cart.css">
    <link rel="stylesheet" href="/css/chat/chat.css">
    <link rel="stylesheet" href="/css/order/order.css">
    <link rel="stylesheet" href="/css/product/card.css">
    <link rel="stylesheet" href="/css/product/main.css">
    <link rel="stylesheet" href="/css/user/admin-owner-layout.css">
    <link rel="stylesheet" href="/css/product/user-detail.css">
    <link rel="stylesheet" href="/css/product/ownerlist.css">
    <link rel="stylesheet" href="/css/category/category-save-form.css">
    <link rel="stylesheet" href="/css/category/category-list.css">
    <link rel="stylesheet" href="/css/products/edit-form.css">
    <link rel="stylesheet" href="/css/chat/chatList.css">
    <link rel="stylesheet" href="/css/user/admin-product-list.css">
    <link rel="stylesheet" href="/css/review/review-update.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
    <!-- 공통 테마: 반드시 마지막에 불러와 위 스타일을 덮어쓴다 -->
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

<header class="site-header">
    <div class="site-container header-row">
        <a href="/" class="brand-logo" aria-label="DEVSHOP 홈">
            <img src="/img/logo.png" alt="DEVSHOP"/>
        </a>

        {{> layout/nav }}

        <nav class="header-actions" aria-label="내 메뉴">
            {{#sessionUser}}
                {{#isAdmin}}<a href="/admin/main" class="text-action">관리자</a>{{/isAdmin}}
                {{#isOwner}}<a href="/owner/dashboard" class="text-action">판매자 센터</a>{{/isOwner}}
                {{^isAdmin}}
                    <a href="/order/list" class="icon-action"><i class="bi bi-person"></i><span>마이</span></a>
                    <a href="/cart/list" class="icon-action"><i class="bi bi-bag"></i><span>장바구니</span></a>
                {{/isAdmin}}
                <a href="/user/logout" class="text-action">로그아웃</a>
            {{/sessionUser}}
            {{^sessionUser}}
                <a href="/user/join" class="text-action">회원가입</a>
                <a href="/user/login" class="btn-pill">로그인</a>
            {{/sessionUser}}
        </nav>
    </div>
</header>
