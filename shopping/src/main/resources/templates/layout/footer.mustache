<script>
    function closeBanner() {
        const banner = document.getElementById('floatingBanner');
        // 부드럽게 사라지는 효과
        banner.style.opacity = '0';
        banner.style.transform = 'scale(0.9)';
        setTimeout(() => {
            banner.style.display = 'none';
        }, 300);
    }
</script>

<script>
    // data-won 이 붙은 금액에 천 단위 쉼표를 넣는다 (서버가 숫자 그대로 넘기는 화면용)
    document.querySelectorAll("[data-won]").forEach(function (el) {
        var n = Number(el.textContent.trim());
        if (!isNaN(n)) el.textContent = n.toLocaleString("ko-KR");
    });
</script>
