{{> layout/header }}

<main>
    <section class="hero carousel slide" id="hero" data-bs-ride="carousel" aria-label="기획전">
        <div class="carousel-inner">
            <div class="carousel-item active"><img src="/img/banner1.png" alt="기획전 배너 1"></div>
            <div class="carousel-item"><img src="/img/banner2.jpg" alt="기획전 배너 2"></div>
            <div class="carousel-item"><img src="/img/banner3.jpg" alt="기획전 배너 3"></div>
        </div>
        <div class="hero-dots carousel-indicators">
            <button type="button" data-bs-target="#hero" data-bs-slide-to="0" class="active" aria-label="배너 1"></button>
            <button type="button" data-bs-target="#hero" data-bs-slide-to="1" aria-label="배너 2"></button>
            <button type="button" data-bs-target="#hero" data-bs-slide-to="2" aria-label="배너 3"></button>
        </div>
    </section>

    <div class="site-container">
        <nav class="shortcut-row" aria-label="카테고리 바로가기">
            {{#category}}
                <a href="/category/{{id}}" class="shortcut">
                    <span class="shortcut-image">
                        {{#imageUrl}}<img src="{{imageUrl}}" alt="">{{/imageUrl}}
                    </span>
                    <span class="shortcut-label">{{categoryName}}</span>
                </a>
            {{/category}}
        </nav>

        {{> product/card }}
    </div>

{{> layout/footer }}
