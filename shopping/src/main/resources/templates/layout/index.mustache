{{> layout/header }}

<main class="site-container">
    <section class="intro" aria-label="사이트 소개">
        <div class="intro-text">
            <h1>개발자 책상을 채우는<br>작은 상점들</h1>
            <p>키보드부터 러버덕까지, 입점 판매자들이 직접 고른 책상 용품을 모았어요.</p>
            <div class="chip-row">
                {{#category}}<a href="/category/{{id}}" class="chip">{{categoryName}}</a>{{/category}}
            </div>
        </div>
        <div class="intro-mosaic">
            {{#category}}
                <a href="/category/{{id}}" class="mosaic-cell">
                    {{#imageUrl}}<img src="{{imageUrl}}" alt="">{{/imageUrl}}
                    <span>{{categoryName}}</span>
                </a>
            {{/category}}
        </div>
    </section>

    {{> product/card }}
{{> layout/footer }}
