{{#statistic}}
<section class="pd-rating" aria-label="별점 분포">
    <h2 class="pd-section-title">별점 분포</h2>
    <div class="pd-bar"><span>5점</span><i><b style="width: {{fifthPercentage}}%"></b></i><em>{{fifthPercentage}}%</em></div>
    <div class="pd-bar"><span>4점</span><i><b style="width: {{forthPercentage}}%"></b></i><em>{{forthPercentage}}%</em></div>
    <div class="pd-bar"><span>3점</span><i><b style="width: {{thirdPercentage}}%"></b></i><em>{{thirdPercentage}}%</em></div>
    <div class="pd-bar"><span>2점</span><i><b style="width: {{secondPercentage}}%"></b></i><em>{{secondPercentage}}%</em></div>
    <div class="pd-bar"><span>1점</span><i><b style="width: {{firstPercentage}}%"></b></i><em>{{firstPercentage}}%</em></div>
</section>
{{/statistic}}
