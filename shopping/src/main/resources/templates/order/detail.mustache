{{#order}}
<a href="/order/list" class="ct-back mp-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> 주문 내역</a>
<h1 class="mp-title">주문 상세</h1>

<div class="ct-layout">
    <section class="mp-order" aria-label="주문 상품">
        <header class="mp-order-head"><div><strong>주문 상품 {{orderItems.size}}개</strong></div></header>
        {{#orderItems}}
        <div class="mp-order-item" data-status="{{status}}">
            <a href="/products/{{productId}}" class="ct-thumb"><img src="{{thumbnailUrl}}" alt=""></a>
            <div class="mp-order-info">
                <span class="mp-status">{{statusDisplay}}</span>
                <a href="/products/{{productId}}" class="ct-name">{{productName}}</a>
                <p class="ct-code">{{productCode}} · {{quantity}}개</p>
            </div>
            <p class="ct-price"><strong>{{orderAmount}}원</strong></p>
        </div>
        {{/orderItems}}
    </section>

    <aside class="ct-summary" aria-label="결제 정보">
        <h2>결제 정보</h2>
        <dl>
            <div><dt>결제 수단</dt><dd>{{#method}}{{method}}{{/method}}</dd></div>
            <div><dt>결제 일시</dt><dd>{{#approvedAt}}{{approvedAt}}{{/approvedAt}}{{^approvedAt}}-{{/approvedAt}}</dd></div>
        </dl>
        <p class="ct-total"><span>결제 금액</span><strong>{{totalAmount}}원</strong></p>
    </aside>
</div>
{{/order}}
