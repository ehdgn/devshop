<form action="/order/list" class="mp-search" role="search">
    <i class="bi bi-search" aria-hidden="true"></i>
    <input type="search" name="keyword" value="{{#keyword}}{{keyword}}{{/keyword}}" placeholder="상품 이름으로 찾기" aria-label="주문 검색">
    {{#keyword}}<a href="/order/list" class="mp-search-reset">전체 보기</a>{{/keyword}}
</form>

{{#orderList}}
<article class="mp-order">
    <header class="mp-order-head">
        <div>
            <strong>{{orderedAt}}</strong>
            <span>주문번호 {{orderNumber}}</span>
        </div>
        <a href="/order/detail?orderId={{id}}">주문 상세 <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
    </header>

    {{#orderItems}}
    <div class="mp-order-item" data-status="{{status}}">
        <a href="/products/{{productId}}" class="ct-thumb"><img src="{{thumbnailUrl}}" alt=""></a>
        <div class="mp-order-info">
            <span class="mp-status">{{statusDisplay}}</span>
            <a href="/products/{{productId}}" class="ct-name">{{productName}}</a>
            <p class="ct-code">{{orderAmount}}원 · {{quantity}}개</p>
        </div>
        <div class="mp-order-actions">
            <button type="button" class="btn-buy confirmBtn" data-item-id="{{id}}">구매확정</button>
            <button type="button" class="btn-line refundBtn" data-item-id="{{id}}">반품 신청</button>
            <a href="/review/{{productId}}/save" class="btn-line reviewBtn">리뷰 쓰기</a>
        </div>
    </div>
    {{/orderItems}}
</article>
{{/orderList}}

{{^orderList}}
<div class="pd-empty">
    <i class="bi bi-receipt" aria-hidden="true"></i>
    <p>{{#keyword}}'{{keyword}}'에 맞는 주문이 없어요.{{/keyword}}{{^keyword}}아직 주문한 상품이 없어요.{{/keyword}}</p>
    <a href="/" class="btn-line ct-empty-link">상품 둘러보기</a>
</div>
{{/orderList}}

<script>
    // 뒤로가기로 메모리에서 되살아난 페이지(bfcache)는 예전 상태라 새로 불러온다
    window.addEventListener('pageshow', e => { if (e.persisted) location.reload(); });

    const STATUS_LABEL = {PAID: '결제 완료', CONFIRMED: '구매 확정', REFUNDED: '환불 완료'};

    // 상태에 따라 보여 줄 버튼: 결제 완료 → 확정·반품, 구매 확정 → 리뷰, 환불 → 없음
    function renderStatus(item, status) {
        item.dataset.status = status;
        item.querySelector('.mp-status').textContent = STATUS_LABEL[status] || status;
        item.querySelector('.confirmBtn').hidden = status !== 'PAID';
        item.querySelector('.refundBtn').hidden = status !== 'PAID';
        item.querySelector('.reviewBtn').hidden = status !== 'CONFIRMED';
    }

    document.querySelectorAll('.mp-order-item').forEach(item => renderStatus(item, item.dataset.status));

    async function postItem(url, body) {
        const response = await fetch(url, {
            method: 'POST',
            headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
            body: body ? JSON.stringify(body) : undefined
        });
        if (response.ok) return true;
        const errorData = await response.json().catch(() => ({}));
        alert(errorData.message || "처리하지 못했습니다. 잠시 후 다시 시도해주세요.");
        return false;
    }

    document.querySelectorAll('.confirmBtn').forEach(btn => btn.addEventListener('click', async () => {
        if (!confirm("구매확정 하시겠습니까?")) return;
        try {
            if (await postItem(`/order/items/${btn.dataset.itemId}/confirm`)) renderStatus(btn.closest('.mp-order-item'), 'CONFIRMED');
        } catch (e) {
            alert("오류가 발생했습니다. " + e.message);
        }
    }));

    document.querySelectorAll('.refundBtn').forEach(btn => btn.addEventListener('click', async () => {
        const reason = prompt("환불 사유를 입력해주세요:", "단순 변심");
        if (!reason) return;
        if (!confirm("반품하시겠습니까?")) return;
        try {
            if (await postItem(`/order/items/${btn.dataset.itemId}/refund`, {reason: reason, amount: null})) {
                renderStatus(btn.closest('.mp-order-item'), 'REFUNDED');
                alert("환불이 완료되었습니다.");
            }
        } catch (e) {
            alert("오류가 발생했습니다. " + e.message);
        }
    }));
</script>
