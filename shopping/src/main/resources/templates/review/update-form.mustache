<a href="/review/{{reviewId}}" class="ct-back mp-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> 리뷰로 돌아가기</a>
<h1 class="mp-title">리뷰 수정</h1>

{{#review.reviewImage}}
<div class="mp-panel mp-photo-row">
    <img src="/images/{{review.reviewImage}}" alt="지금 리뷰 사진" class="mp-review-photo">
    <form action="/review/{{reviewId}}/review-image/delete" method="post" onsubmit="return confirm('리뷰 사진을 삭제하시겠습니까?')">
        <button type="submit" class="btn-delete">사진 삭제</button>
    </form>
</div>
{{/review.reviewImage}}

<form action="/review/{{reviewId}}/update" method="post" enctype="multipart/form-data" class="mp-panel mp-form">
    <fieldset class="mp-field">
        <legend>별점</legend>
        <div class="mp-rate">
            <input type="radio" id="star-5" name="rating" value="5" {{#review.checked5}}checked{{/review.checked5}}><label for="star-5" title="5점">★</label>
            <input type="radio" id="star-4" name="rating" value="4" {{#review.checked4}}checked{{/review.checked4}}><label for="star-4" title="4점">★</label>
            <input type="radio" id="star-3" name="rating" value="3" {{#review.checked3}}checked{{/review.checked3}}><label for="star-3" title="3점">★</label>
            <input type="radio" id="star-2" name="rating" value="2" {{#review.checked2}}checked{{/review.checked2}}><label for="star-2" title="2점">★</label>
            <input type="radio" id="star-1" name="rating" value="1" {{#review.checked1}}checked{{/review.checked1}}><label for="star-1" title="1점">★</label>
        </div>
    </fieldset>

    <label class="mp-field">
        <span>리뷰 내용</span>
        <textarea name="content" rows="6" required>{{review.content}}</textarea>
    </label>

    {{#review.reviewImage}}<input type="hidden" name="reviewImageFilename" value="{{review.reviewImage}}">{{/review.reviewImage}}
    <label class="mp-field">
        <span>{{#review.reviewImage}}사진 바꾸기{{/review.reviewImage}}{{^review.reviewImage}}사진{{/review.reviewImage}} <small>(선택, JPG·PNG·GIF)</small></span>
        <input type="file" name="reviewImage" accept="image/*">
    </label>

    <div class="mp-form-actions">
        <a href="/review/{{reviewId}}" class="btn-line">취소</a>
        <button type="submit" class="btn-buy">수정 완료</button>
    </div>
</form>
