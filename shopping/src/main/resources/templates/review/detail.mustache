<a href="/review/list" class="ct-back mp-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> 내가 쓴 리뷰</a>
<h1 class="mp-title">리뷰 상세</h1>

{{#review}}
<article class="mp-panel mp-review-detail">
    <p class="mp-stars mp-stars-lg" aria-label="{{rating}}점">{{#stars}}★{{/stars}}<span>{{#emptyStars}}★{{/emptyStars}}</span></p>
    <p class="ct-code">{{#username}}{{username}}{{/username}}{{#createdAt}} · {{createdAt}}{{/createdAt}}</p>
    {{#reviewImage}}<img src="/images/{{reviewImage}}" alt="리뷰 사진" class="mp-review-photo">{{/reviewImage}}
    <p class="mp-review-text">{{content}}</p>
</article>
{{/review}}

{{#isOwner}}
<div class="mp-panel-actions">
    <a href="/review/{{reviewId}}/update" class="btn-line">수정</a>
    <form action="/review/{{reviewId}}/delete" method="post" onsubmit="return confirm('리뷰를 삭제하시겠습니까?')">
        <button class="btn-delete">삭제</button>
    </form>
</div>
{{/isOwner}}
