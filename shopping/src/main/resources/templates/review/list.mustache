{{#reviewList}}
<article class="mp-review">
    <header>
        <a href="/products/{{productId}}" class="ct-name">{{productName}}</a>
        {{#createdAt}}<span class="ct-code">{{createdAt}}</span>{{/createdAt}}
    </header>
    <p class="mp-stars" aria-label="{{rating}}점">{{#stars}}★{{/stars}}<span>{{#emptyStars}}★{{/emptyStars}}</span></p>
    <p class="mp-review-text">{{content}}</p>
    <a href="/review/{{id}}" class="mp-more">자세히 보기 <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
</article>
{{/reviewList}}

{{^reviewList}}
<div class="pd-empty">
    <i class="bi bi-star" aria-hidden="true"></i>
    <p>아직 쓴 리뷰가 없어요. 구매를 확정하면 리뷰를 쓸 수 있어요.</p>
    <a href="/order/list" class="btn-line ct-empty-link">주문 내역 보기</a>
</div>
{{/reviewList}}
